{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "启动Go程序",
            "type": "go",
            "request": "launch",
            "mode": "auto",
            "program": "${workspaceFolder}/main.go",
            "env": {
                "GO111MODULE": "on",
                "GOPROXY": "https://goproxy.cn,direct"
            },
            "args": [],
            "cwd": "${workspaceFolder}"
        },
        {
            "name": "调试当前文件",
            "type": "go",
            "request": "launch",
            "mode": "debug",
            "program": "${file}",
            "env": {
                "GO111MODULE": "on",
                "GOPROXY": "https://goproxy.cn,direct"
            }
        }
    ]
}