package {{ .packageName }}

import (
	"github.com/gin-gonic/gin"
    "gofly/internal/domain/dto"
	"gofly/internal/domain/service"
    "gofly/internal/model/base"
    "gofly/internal/model/biz"
	"gofly/pkg/utils/assert"
    "gofly/pkg/utils/gf"
    "gofly/pkg/utils/results"
    "strings"
)

type {{ .UpFileName }} struct {
	svc *service.{{ .tableNameUpper }} `inject:""`
}

func init() {
    gf.RegisterRoute(&{{ .UpFileName }}{})
}

// 获取列表
func (s *{{ .UpFileName }}) Get_list(c *gin.Context) {
	req := gf.ReqQuery(c, &dto.{{ .tableNameUpper }}PageReq{})
	cond := base.NewCond()
	cond.Fields = "{{ .fields }}"
	cond.Order = "id desc"

    cond.Where(req.Title, "name like ?", "%"+req.Title+"%")

    if req.CreatedTime != "" {
        datetimeArr := strings.Split(req.CreatedTime, ",")
        cond.Where(req.CreatedTime, "create_time between ? and ?", datetimeArr[0]+" 00:00:00", datetimeArr[1]+" 23:59:59")
    }

    list, err := s.svc.Page(c, *req.IPage, cond)
    results.ResPage(c, *req.IPage, list, err)
}

// 保存
func (s *{{ .UpFileName }}) Save(c *gin.Context) {
    entity := gf.ReqBody(c, &biz.{{ .tableNameUpper }}{})
    res, err := s.svc.InsertOrUpdate(c, entity)
	go s.svc.UpdateWeigh(c, entity.Id)
    results.ResSave(c, res, err)
}

// 更新状态
func (s *{{ .UpFileName }}) UpStatus(c *gin.Context) {
    req := gf.ReqBody(c, &base.StatusUpd{})
	res, err := s.svc.UpdateStatus(c, req)
	results.ResSave(c, res, err)
}

// 删除
func (s *{{ .UpFileName }}) Del(c *gin.Context) {
	ids := gf.ReqBody(c, &base.Ids{})
    res, err := s.svc.DeleteBatch(c, ids)
    results.ResDel(c, res, err)
}

// 获取详情
func (s *{{ .UpFileName }}) Get_content(c *gin.Context) {
	id := c.DefaultQuery("id", "")
    assert.Nil(id, "请传参数id")

	res, err := s.svc.GetById(c, id)
	results.ResObj(c, res, err)
}


// 获取分类列表
func (s *Replace) Get_cate(c *gin.Context) {
	list, err := model.DB().Table("{{ .tablename }}").Fields("id as value,name as label").Order("weigh desc,id desc").Get()
    results.ResObj(c, list, err)
}

func (s *Replace) Perms() map[string][]gin.HandlerFunc {
	return nil
}
